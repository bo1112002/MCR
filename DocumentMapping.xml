  <EntityMaping Key="SOUP" MapingType="MCR.Mods.SoundPage"  TableName="SoundPage"  DataBaseKey="connA">
    <Parames>
      <P PropertyName="AutoID" SourceColumn="AutoID" DbType="Int" Size="50" Direction="Input" />
      <P PropertyName="MemberID" SourceColumn="MemberID" DbType="Int" Size="50" Direction="Input" />
      <P PropertyName="DocumentID" SourceColumn="DocumentID" DbType="Int" Size="4" Direction="Input" />
      <P PropertyName="CourseInfoID" SourceColumn="CourseInfoID" DbType="Int" Size="50" Direction="Input" />
