  <!--操作方式(下面的有效值只能在 -9000到+9000内用户的操作方可有效，超出该范围的为系统使用)-->
  <KeyValueClass Key="MoneyTrading" Val=""  Tag="Tag">
    <Childs>

      <!--支付方式
        M：需要指定一个实现了EntityDB抽象类型的对象类型,又用于重新指定数据对象的验证及持久的个性处理
        -->
      <KeyValueClass Key="8000" Val="SYSTEM"  Tag="系统">
        <Childs>
          <KeyValueClass Key="0" Tag="现金" />
          <KeyValueClass Key="1" Tag="充值卡"  M="Core.Model.My.Money.OrderSettle2_DB,Core" />
          <KeyValueClass Key="2" Tag="信用卡" />
          <KeyValueClass Key="3" Tag="代金券" />


          <KeyValueClass Key="-60" Tag="充值赠送" />
          
          <!--
          <KeyValueClass Key="4000" Tag="输错" />
          <KeyValueClass Key="2000" Tag="其它营业支出或收入" />
          
<KeyValueClass Key="8001" Tag="自动销售" M="Core.Model.My.Money.UserNotInsert,Core" />
          <KeyValueClass Key="-40" Tag="扣减优惠" />
          <KeyValueClass Key="-41" Tag="打折优惠" />
          <KeyValueClass Key="-50" Tag="代金券" />
          
          <KeyValueClass Key="-80" Tag="多收或少收" />
          <KeyValueClass Key="-90" Tag="取整" />
          <KeyValueClass Key="-1000" Tag="积分" />
          <KeyValueClass Key="-2000" Tag="其它营业外支出或收入" />
          <KeyValueClass Key="-3000" Tag="其它优惠" />-->

        </Childs>
      </KeyValueClass>
      
      <!--某些操作是需要分配特权，才能进行的-->
      <KeyValueClass Key="1" Val="SELL" Tag="销售" M="Core.Model.My.Money.OrderSettle_Factory,Core">
        <Childs>
          <KeyValueClass Key="30" Tag="收款" RefChildsKey="MoneyTrading->8000[0,2,3,1]" />
          <KeyValueClass Key="31" Tag="找零" RefChildsKey="MoneyTrading->8000[0]" />
          <KeyValueClass Key="-32" Tag="优惠" RefChildsKey="MoneyTrading->8000[0]" />
        </Childs>
      </KeyValueClass>

      <KeyValueClass Key="11"  Val="CUSTOMER_MONEY" Tag="顾客金额功能"  M="Core.Model.My.Money.CustomerMoney_Factory,Core" >
        <Childs>
          <KeyValueClass Key="10" Tag="冲值" RefChildsKey="MoneyTrading->8000[0,2]" />
          <KeyValueClass Key="-10" Tag="充值赠送" RefChildsKey="MoneyTrading->8000[0]" />
          <KeyValueClass Key="20" Tag="预付" RefChildsKey="MoneyTrading->8000[0,2]" />
        </Childs>
      </KeyValueClass>

      
    </Childs>
  </KeyValueClass>

